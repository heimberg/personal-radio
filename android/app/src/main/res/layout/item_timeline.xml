<?xml version="1.0" encoding="utf-8"?>
<!-- One program item: planned time, title, show and state; the rule below fades at both ends. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/rule_bottom"
    android:foreground="?attr/selectableItemBackground"
    android:gravity="center_vertical"
    android:minHeight="52dp"
    android:orientation="horizontal"
    android:paddingStart="@dimen/space_1"
    android:paddingTop="@dimen/space_3"
    android:paddingEnd="@dimen/space_1"
    android:paddingBottom="@dimen/space_3">

    <!-- The colour of the item's kind, as a thin bar at the start. -->
    <View
        android:id="@+id/kind_bar"
        android:layout_width="3dp"
        android:layout_height="match_parent"
        android:layout_marginEnd="@dimen/space_2" />

    <TextView
        android:id="@+id/time"
        style="@style/Widget.PersonalRadio.Text.Meta"
        android:layout_width="38dp"
        android:layout_height="wrap_content"
        android:textColor="@color/text" />

    <TextView
        android:id="@+id/kind_icon"
        android:layout_width="30dp"
        android:layout_height="30dp"
        android:layout_marginStart="@dimen/space_2"
        android:gravity="center"
        android:importantForAccessibility="no"
        android:textSize="15sp" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/space_3"
        android:layout_marginEnd="@dimen/space_4"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/kind_label"
            style="@style/Widget.PersonalRadio.Text.Meta"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:letterSpacing="0.08"
            android:textAllCaps="true"
            android:textSize="10sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/title"
            style="@style/Widget.PersonalRadio.Text.ItemTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <TextView
            android:id="@+id/meta"
            style="@style/Widget.PersonalRadio.Text.Meta"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <TextView
            android:id="@+id/error"
            style="@style/Widget.PersonalRadio.Text.Meta"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/accent_300"
            android:visibility="gone" />
    </LinearLayout>

    <ImageView
        android:id="@+id/state"
        android:layout_width="16dp"
        android:layout_height="16dp"
        android:importantForAccessibility="no"
        app:tint="@color/neutral_500" />

    <!-- Program list only, for surprises: swap for another one or take it out. -->
    <ImageView
        android:id="@+id/swap"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_marginStart="@dimen/space_1"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="@string/surprise_options"
        android:padding="10dp"
        android:src="@drawable/ic_dice"
        android:visibility="gone"
        app:tint="@color/accent_300" />

    <!-- Program list only: touch and drag to move the item. -->
    <ImageView
        android:id="@+id/handle"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_marginStart="@dimen/space_2"
        android:contentDescription="@string/move"
        android:padding="10dp"
        android:src="@drawable/ic_dots_six"
        android:visibility="gone"
        app:tint="@color/neutral_500" />
</LinearLayout>
