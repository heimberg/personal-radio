<?xml version="1.0" encoding="utf-8"?>
<!--
    Direction 1c "Kompakt" of the Nocturne redesign: a dense player card with a small orb and a waveform,
    so the program list shows without scrolling. Actions follow below it.
-->
<!-- Pull down to refresh. -->
<androidx.swiperefreshlayout.widget.SwipeRefreshLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/refresh"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true">

<ScrollView
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:scrollbars="none">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="@dimen/space_6"
        android:paddingEnd="@dimen/space_6"
        android:paddingBottom="@dimen/space_8">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingTop="@dimen/space_4"
            android:paddingBottom="@dimen/space_3">

            <ImageView
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:importantForAccessibility="no"
                android:src="@drawable/brand_mark" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/space_2"
                android:layout_weight="1"
                android:fontFamily="@font/inter_medium"
                android:letterSpacing="-0.01"
                android:text="@string/brand"
                android:textColor="@color/text"
                android:textSize="15sp" />

            <!-- Shown so an installed build can be matched to its CI run. -->
            <TextView
                android:id="@+id/version"
                style="@style/Widget.PersonalRadio.Text.Tag"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/tag_background"
                android:paddingStart="10dp"
                android:paddingTop="3dp"
                android:paddingEnd="10dp"
                android:paddingBottom="3dp" />
        </LinearLayout>

        <TextView
            style="@style/Widget.PersonalRadio.Text.Eyebrow"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_2"
            android:text="@string/eyebrow" />

        <TextView
            style="@style/Widget.PersonalRadio.Text.Headline"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_1"
            android:accessibilityHeading="true"
            android:text="@string/headline" />

        <!-- A newer build is on the Worker: one tap downloads and installs it. -->
        <LinearLayout
            android:id="@+id/update"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_4"
            android:background="@drawable/callout_background"
            android:orientation="vertical"
            android:padding="@dimen/space_4"
            android:visibility="gone">

            <TextView
                android:id="@+id/update_text"
                style="@style/Widget.PersonalRadio.Text.Body"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:accessibilityLiveRegion="polite"
                android:textColor="@color/accent_200" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/update_install"
                style="@style/Widget.PersonalRadio.Button.Primary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_2"
                android:text="@string/update_install" />
        </LinearLayout>

        <!-- Player card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_6"
            android:background="@drawable/card_background"
            android:orientation="vertical"
            android:padding="@dimen/space_4">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ch.heimberg.radio.OrbView
                    android:id="@+id/orb"
                    android:layout_width="56dp"
                    android:layout_height="56dp"
                    android:importantForAccessibility="no" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/space_4"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <View
                            android:id="@+id/live_dot"
                            android:layout_width="6dp"
                            android:layout_height="6dp"
                            android:layout_marginTop="4.5dp"
                            android:background="@drawable/live_dot"
                            android:backgroundTint="@color/neutral_600" />

                        <!-- Also carries feedback and error messages, such as why Access refused the app. -->
                        <TextView
                            android:id="@+id/status"
                            style="@style/Widget.PersonalRadio.Text.Status"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/space_2"
                            android:layout_weight="1"
                            android:accessibilityLiveRegion="polite" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/title"
                        style="@style/Widget.PersonalRadio.Text.Title"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="@string/nothing_playing" />

                    <TextView
                        android:id="@+id/show"
                        style="@style/Widget.PersonalRadio.Text.Meta"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content" />
                </LinearLayout>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/sleep"
                    style="@style/Widget.PersonalRadio.Button.Icon"
                    android:layout_width="@dimen/touch_target"
                    android:layout_height="@dimen/touch_target"
                    android:contentDescription="@string/sleep"
                    android:tooltipText="@string/sleep"
                    app:icon="@drawable/ic_moon" />
            </LinearLayout>

            <ch.heimberg.radio.WaveformView
                android:id="@+id/progress"
                android:layout_width="match_parent"
                android:layout_height="28dp"
                android:layout_marginTop="@dimen/space_4"
                android:importantForAccessibility="no" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_3"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/time"
                    style="@style/Widget.PersonalRadio.Text.Meta"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/transcript"
                    style="@style/Widget.PersonalRadio.Button.Icon"
                    android:layout_width="@dimen/touch_target"
                    android:layout_height="@dimen/touch_target"
                    android:layout_marginEnd="@dimen/space_1"
                    android:contentDescription="@string/transcript"
                    android:tooltipText="@string/transcript"
                    app:icon="@drawable/ic_info" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/more"
                    style="@style/Widget.PersonalRadio.Button.Icon"
                    android:layout_width="@dimen/touch_target"
                    android:layout_height="@dimen/touch_target"
                    android:layout_marginEnd="@dimen/space_1"
                    android:contentDescription="@string/more"
                    android:tooltipText="@string/more"
                    app:icon="@drawable/ic_plus_circle" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/dislike"
                    style="@style/Widget.PersonalRadio.Button.Icon"
                    android:layout_width="@dimen/touch_target"
                    android:layout_height="@dimen/touch_target"
                    android:contentDescription="@string/dislike"
                    android:tooltipText="@string/dislike"
                    app:icon="@drawable/ic_thumbs_down" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/like"
                    style="@style/Widget.PersonalRadio.Button.Icon"
                    android:layout_width="@dimen/touch_target"
                    android:layout_height="@dimen/touch_target"
                    android:layout_marginStart="@dimen/space_1"
                    android:contentDescription="@string/like"
                    android:tooltipText="@string/like"
                    app:icon="@drawable/ic_thumbs_up" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/play_pause"
                    style="@style/Widget.PersonalRadio.Button.Play"
                    android:layout_width="@dimen/touch_target"
                    android:layout_height="@dimen/touch_target"
                    android:layout_marginStart="@dimen/space_2"
                    android:contentDescription="@string/play"
                    app:icon="@drawable/ic_play" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/next"
                    style="@style/Widget.PersonalRadio.Button.Icon"
                    android:layout_width="@dimen/touch_target"
                    android:layout_height="@dimen/touch_target"
                    android:layout_marginStart="@dimen/space_2"
                    android:contentDescription="@string/next"
                    android:tooltipText="@string/next"
                    app:icon="@drawable/ic_skip_forward" />
            </LinearLayout>
        </LinearLayout>

        <!-- Building blocks: tap one and it comes next; at most one word to type. -->
        <TextView
            style="@style/Widget.PersonalRadio.Text.Section"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_6"
            android:accessibilityHeading="true"
            android:text="@string/blocks" />

        <TextView
            style="@style/Widget.PersonalRadio.Text.Meta"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_1"
            android:text="@string/blocks_hint" />

        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_2"
            android:scrollbars="none">

            <LinearLayout
                android:id="@+id/blocks"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal" />
        </HorizontalScrollView>

        <!-- Program list -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_6"
            android:baselineAligned="true"
            android:orientation="horizontal">

            <TextView
                style="@style/Widget.PersonalRadio.Text.Section"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:accessibilityHeading="true"
                android:text="@string/upcoming" />

            <TextView
                android:id="@+id/upcoming_count"
                style="@style/Widget.PersonalRadio.Text.Meta"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />
        </LinearLayout>

        <TextView
            style="@style/Widget.PersonalRadio.Text.Meta"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_1"
            android:text="@string/upcoming_hint" />

        <!-- Rows move with the finger on their handle; times say when each item starts from now. -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/upcoming"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_2"
            android:overScrollMode="never" />

        <TextView
            android:id="@+id/upcoming_empty"
            style="@style/Widget.PersonalRadio.Text.Body"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_2"
            android:text="@string/nothing_planned"
            android:visibility="gone" />

        <!-- Why the program could not be loaded: the access diagnosis names the layer that refused. -->
        <LinearLayout
            android:id="@+id/notice"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_3"
            android:background="@drawable/callout_background"
            android:orientation="horizontal"
            android:padding="@dimen/space_4"
            android:visibility="gone">

            <ImageView
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_warning_circle"
                app:tint="@color/accent_200" />

            <TextView
                android:id="@+id/notice_text"
                style="@style/Widget.PersonalRadio.Text.Body"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/space_3"
                android:layout_weight="1"
                android:accessibilityLiveRegion="polite"
                android:textColor="@color/accent_200" />
        </LinearLayout>

        <!-- Actions -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/spotify"
            style="@style/Widget.PersonalRadio.Button"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_6"
            android:text="@string/spotify_connect"
            android:visibility="gone"
            app:icon="@drawable/ic_spotify" />

        <TextView
            android:id="@+id/spotify_status"
            style="@style/Widget.PersonalRadio.Text.Body"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_2"
            android:accessibilityLiveRegion="polite"
            android:textColor="@color/accent_300"
            android:visibility="gone" />

        <!-- Listening back and changing the program: the two things used besides playing. -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_6"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/archive"
                style="@style/Widget.PersonalRadio.Button"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/archive"
                app:icon="@drawable/ic_archive" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/cockpit"
                style="@style/Widget.PersonalRadio.Button"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/space_2"
                android:layout_weight="1"
                android:text="@string/settings"
                app:icon="@drawable/ic_sliders" />
        </LinearLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/connection"
            style="@style/Widget.PersonalRadio.Button.Ghost"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_2"
            android:text="@string/connection"
            app:icon="@drawable/ic_plugs" />
    </LinearLayout>
</ScrollView>
</androidx.swiperefreshlayout.widget.SwipeRefreshLayout>
