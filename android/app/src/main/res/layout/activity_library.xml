<?xml version="1.0" encoding="utf-8"?>
<!-- The archive: every production that can still be heard, grouped by day, newest first. -->
<!-- Pull down to refresh. -->
<androidx.swiperefreshlayout.widget.SwipeRefreshLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/refresh"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true">

<ScrollView
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:scrollbars="none">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="@dimen/space_6"
        android:paddingEnd="@dimen/space_6"
        android:paddingBottom="@dimen/space_8">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingTop="@dimen/space_2"
            android:paddingBottom="@dimen/space_2">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/back"
                style="@style/Widget.PersonalRadio.Button.Icon"
                android:layout_width="@dimen/touch_target"
                android:layout_height="@dimen/touch_target"
                android:contentDescription="@string/back"
                android:tooltipText="@string/back"
                app:icon="@drawable/ic_arrow_left" />

            <TextView
                style="@style/Widget.PersonalRadio.Text.Title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/space_2"
                android:layout_weight="1"
                android:accessibilityHeading="true"
                android:text="@string/archive" />
        </LinearLayout>

        <TextView
            android:id="@+id/intro"
            style="@style/Widget.PersonalRadio.Text.Body"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_2"
            android:accessibilityLiveRegion="polite"
            android:text="@string/archive_loading" />

        <LinearLayout
            android:id="@+id/items"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_2"
            android:orientation="vertical" />
    </LinearLayout>
</ScrollView>
</androidx.swiperefreshlayout.widget.SwipeRefreshLayout>
